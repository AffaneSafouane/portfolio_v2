# Site configuration
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Contact form — keep server secrets out of NEXT_PUBLIC_* variables
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-public-turnstile-site-key"
TURNSTILE_SECRET_KEY="your-private-turnstile-secret-key"
RESEND_API_KEY="your-private-resend-api-key"
CONTACT_EMAIL="contact@safouane-affane.fr"
# Optional: use a sender address on a domain verified in Resend
EMAIL_FROM="Portfolio <contact@safouane-affane.fr>"
# Redis configuration for rate limiting and spam prevention
UPSTASH_REDIS_REST_URL="https://ton-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="le_token_acl_de_l_utilisateur_portfolio"
